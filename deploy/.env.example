# Copy to .env in the repository root and fill in.

# Password for the first administrator, "admin", created on the very first start. After you
# sign in, set a new password (or add your own administrator) and then delete this line: the
# Administration overview warns while it still works. Leave it empty to create the first
# administrator in the browser instead, with the setup code printed in the log.
BINDER_PASSWORD=

# Optional: comma-separated IPs or IPv4 ranges never rate limited or blocked (e.g. your home).
SECURITY_ALLOWLIST=

# When the daily price update runs: after this hour (0-23) in this time zone.
TZ=America/Vancouver
PRICE_UPDATE_HOUR=5

# Optional: a free pokemontcg.io key (https://dev.pokemontcg.io) raises its request limits for
# card pictures; prices and pictures work without one.
POKEMONTCG_API_KEY=

# Most PriceCharting API calls a day (UTC), so a runaway loop can't put the subscription at risk.
# A 122-card binder needs about 250.
PRICECHARTING_DAILY_LIMIT=2000

# Only for a server of its own (docker compose --profile caddy): its public host name.
DOMAIN=

# Only next to Boards, if Boards was cloned into a folder with another name: <folder>_default
BOARDS_NETWORK=agile-development-operations_default
